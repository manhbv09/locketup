#!name=Locket Custom by Mạnh Bùi
#!desc=Mở khóa Locket Gold, Video 60s & Custom Caption

[Script]
# 1. Mở khóa tính năng & Custom Caption
locket_rc = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/manhbv09/locketup/refs/heads/main/Locket_Unlocked.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag chống dính Cache RevenueCat
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/manhbv09/locketup/refs/heads/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Locket Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/manhbv09/locketup/refs/heads/main/Locket_manhbui.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
