#!name=Locket Custom Edition
#!desc=Crack By nguyenhailong | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 60s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/longcv2/mc/refs/heads/main/vb, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by nguyenhailong)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://github.com/manhbv09/locketup/raw/refs/heads/main/deleteHeader.js, timeout=60

# 3. Kích hoạt Gold & Ngày 29/12/2009
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/longcv2/mc/refs/heads/main/mc, requires-body=true, max-size=-1, timeout=60
